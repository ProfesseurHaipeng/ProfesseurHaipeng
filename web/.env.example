# MiniMax for the bottom-right site guide. Do not prefix with VITE_ — that would leak the key to the browser.
MINIMAX_API_KEY=
# International: https://api.minimax.io/v1
# China Token Plan (sk-cp- keys): https://api.minimaxi.com/v1
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Text-01
# Older MiniMax accounts may still need a GroupId
MINIMAX_GROUP_ID=

# Senior advisor Hermes — a separate OpenAI-compatible server, usually on a private NAS.
# The browser never talks to the NAS. Netlify /api/guide calls this URL server-side.
# Expose the NAS with a public HTTPS tunnel first (Cloudflare Tunnel is the usual choice).
# Example after the tunnel is up: https://hermes.example.com/v1
HERMES_API_BASE=
# Use "local" if the Hermes server does not require a key.
HERMES_API_KEY=local
HERMES_MODEL=hermes

# Optional: point the static site at a hosted /api/guide (Cloudflare Worker or Netlify function)
# VITE_GUIDE_URL=https://example.workers.dev/api/guide
