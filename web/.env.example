# MiniMax for the bottom-right site guide. Do not prefix with VITE_ — that would leak the key to the browser.
MINIMAX_API_KEY=
# International: https://api.minimax.io/v1
# China Token Plan (sk-cp- keys): https://api.minimaxi.com/v1
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Text-01
# Older MiniMax accounts may still need a GroupId
MINIMAX_GROUP_ID=

# Senior advisor Hermes — Netlify /api/guide calls this OpenAI-compatible gateway server-side.
# Do not point this at a LAN IP or a raw NAS port. Use the dedicated advisor gateway only.
HERMES_API_BASE=https://advisor.arriverready.com/v1
# Restricted key generated for this site. Never a NAS admin token.
HERMES_API_KEY=
HERMES_MODEL=weho-senior-advisor

# Optional: point the static site at a hosted /api/guide (Cloudflare Worker or Netlify function)
# VITE_GUIDE_URL=https://example.workers.dev/api/guide
